# =============================================================
# My Life · Variables de entorno
# Copiar a .env y rellenar. .env NUNCA se versiona.
# =============================================================

# ---- Cliente (se incluyen en el bundle: solo valores públicos) ----
# La clave anon es pública por diseño. La seguridad vive en las
# políticas RLS, no en ocultar esta clave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# =============================================================
# LAS DE ABAJO NO VAN AQUÍ.
# Se configuran como secretos de Edge Functions:
#   supabase secrets set NOMBRE=valor
# Si alguna acaba con prefijo VITE_ termina en el bundle del
# cliente y queda expuesta a cualquiera que abra la app.
# =============================================================

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=      # cabecera X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_ALLOWED_CHAT_IDS=    # lista blanca separada por comas
# HEALTH_INGEST_TOKEN=          # secreto largo usado por el Atajo de iOS
# LLM_API_KEY=                  # capa 2 del parser (fallback)
# SUPABASE_SERVICE_ROLE_KEY=    # solo para scheduler-tick
